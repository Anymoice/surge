#!name=Surge-Node-AI-Detector
#!desc=节点 IP / AI 可达性检测；无后台轮询，同一节点不重复检测，节点变化后首次打开面板时才检测并提醒
#!author=Anymoice
#!homepage=https://github.com/Anymoice/surge
#!arguments=策略组:Proxy

[Script]
# v4 不再使用 cron。打开/刷新面板时只读取当前策略；节点未变化则直接读取缓存，不访问任何检测服务。
Surge-Node-AI-Detector-Panel = type=generic,timeout=30,script-path=https://raw.githubusercontent.com/Anymoice/surge/main/Surge-Node-AI-Detector.js,script-update-interval=0,engine=webview,argument=mode=panel&group={{{策略组}}}

[Panel]
Surge-Node-AI-Detector = title=节点 AI 检测,content=打开面板检测当前节点,style=info,icon=network.badge.shield.half.filled,script-name=Surge-Node-AI-Detector-Panel,update-interval=0
