#!name = IP 纯净度 & AI 解锁检测
#!desc = 检测当前出口 IP 的纯净度 / 风险评分 / IP 属性，以及 ChatGPT · Claude · Gemini 的区域解锁情况。数据来源：ippure.com 公开接口 + 各 AI 服务区域响应特征
#!category = 面板
#!author = Anymoice
#!homepage = https://github.com/Anymoice/surge

[Panel]
IP 纯净度检测 = script-name=ip-purity, update-interval=600, title=🛡️ IP 纯净度, content=正在检测…, icon=checkmark.shield, style=info
AI 解锁检测 = script-name=ai-unlock, update-interval=600, title=🤖 AI 解锁, content=正在检测…, icon=sparkles, style=info

[Script]
ip-purity = type=generic, timeout=15, script-path=https://raw.githubusercontent.com/Anymoice/surge/main/Scripts/ip-purity.js
ai-unlock = type=generic, timeout=20, script-path=https://raw.githubusercontent.com/Anymoice/surge/main/Scripts/ai-unlock.js
